# =============================================================================
# SOVEREIGN-SRE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# LLM Provider (groq | grok | claude)
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Groq API — Llama 3.3 on LPU hardware (default, free tier available)
# Get your key at: https://console.groq.com
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Available Groq models:
# llama-3.3-70b-versatile  → best quality (RCA + patch generation)
# llama-3.1-8b-instant     → fastest / cheapest (simple classification)
# mixtral-8x7b-32768       → long context (32K window)
# gemma2-9b-it             → lightweight alternative
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# xAI Grok API (optional, set LLM_PROVIDER=grok to activate)
# Get your key at: https://console.x.ai
# -----------------------------------------------------------------------------
# XAI_API_KEY=your_xai_api_key_here
# GROK_MODEL=grok-3-mini

# -----------------------------------------------------------------------------
# Anthropic Claude API (optional, set LLM_PROVIDER=claude to activate)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# GitHub Integration (for autonomous PRs)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=Sovereign-SRE

# -----------------------------------------------------------------------------
# Service URLs (Docker internal networking)
# -----------------------------------------------------------------------------
CHROMA_HOST=http://chromadb:8000
MCP_SERVER_HOST=http://mcp-server:8080

# -----------------------------------------------------------------------------
# Local Development Overrides
# -----------------------------------------------------------------------------
# Uncomment these when running services locally (not in Docker)
# CHROMA_HOST=http://localhost:8000
# MCP_SERVER_HOST=http://localhost:8080

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
EMBED_MODEL=BAAI/bge-m3

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
CHROMA_COLLECTION_NAME=sovereign_sre_codebase
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
HUMAN_APPROVAL_REQUIRED=true
MAX_AUTO_FIX_ATTEMPTS=3

# =============================================================================
# AWS INTEGRATION
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Core
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# -----------------------------------------------------------------------------
# Amazon Bedrock
# BEDROCK COST: Claude Haiku = $0.00025/1K input tokens, $0.00125/1K output
# A typical SRE pipeline run = ~5K tokens total = ~$0.008 per incident
# 100 incidents/month = ~$0.80. Well within $100 budget.
# -----------------------------------------------------------------------------
BEDROCK_ENABLED=true
BEDROCK_DEFAULT_MODEL=haiku
BEDROCK_FALLBACK_TO_OLLAMA=true

# -----------------------------------------------------------------------------
# RDS pgvector (set USE_PGVECTOR=true to activate)
# RDS COST: db.t3.micro = FREE TIER (750 hrs/month for 12 months)
# -----------------------------------------------------------------------------
USE_PGVECTOR=false
RDS_HOST=sovereign-sre-db.xxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=sovereignsre
RDS_USER=sreadmin
RDS_PASSWORD=changeme
# RDS_CONNECTION_STRING is loaded from SSM at runtime (set by setup.py)

# -----------------------------------------------------------------------------
# Step Functions
# COST SAFE: Step Functions <4000 state transitions/month = $0
# -----------------------------------------------------------------------------
STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:sovereign-sre-pipeline

# -----------------------------------------------------------------------------
# SNS / Human Approval
# COST SAFE: SNS <1M emails/month = $0
# -----------------------------------------------------------------------------
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:sovereign-sre-approvals
SNS_APPROVAL_EMAIL=your@email.com

# -----------------------------------------------------------------------------
# DynamoDB
# COST SAFE: DynamoDB pay-per-request, <1000 ops/day = $0
# -----------------------------------------------------------------------------
DYNAMODB_TABLE=sovereign-sre-incidents

# -----------------------------------------------------------------------------
# S3 Artifacts
# COST SAFE: S3 <5GB = $0, presigned URLs are free
# -----------------------------------------------------------------------------
S3_BUCKET=sovereign-sre-artifacts-123456789012

# -----------------------------------------------------------------------------
# Kinesis Firehose
# COST SAFE: Firehose <500K records = $0 (first month)
# -----------------------------------------------------------------------------
FIREHOSE_STREAM=sovereign-sre-logs

# -----------------------------------------------------------------------------
# Lambda
# COST SAFE: Lambda <1M invocations/month = $0
# -----------------------------------------------------------------------------
LAMBDA_FUNCTION_NAME=sovereign-sre-remediation-trigger

# -----------------------------------------------------------------------------
# Backend URL (used by Lambda to notify real-time WebSocket layer)
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:8001
